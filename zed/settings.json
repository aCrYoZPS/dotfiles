// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
    "edit_predictions": {
        "provider": "none",
    },
    "agent_servers": {
        "claude-acp": {
            "default_config_options": {
                "mode": "auto",
                "fast": false,
            },
            "type": "registry",
        },
    },
    "cli_default_open_behavior": "new_window",
    // Makes every panel's ToggleFocus binding an actual toggle. Zed defaults
    // this to false, where a second press only bounces focus back to the
    // editor and leaves the panel open — which is why ctrl-c (agent panel)
    // and <leader>e (project panel) felt like "switch", not "toggle".
    // workspace.rs only calls close_panel() when this is on.
    "close_panel_on_toggle": true,
    "outline_panel": {
        "dock": "left",
    },
    "collaboration_panel": {
        "dock": "left",
    },
    "agent": {
        "sidebar_side": "right",
        "dock": "right",
        "favorite_models": [],
        "model_parameters": [],
    },
    "git_panel": {
        "tree_view": false,
        "dock": "left",
    },
    "git": {
        // Inline blame is on by default. Off here: it reflows the line as you
        // move through a file, and the same information is a keystroke away.
        // <leader>g b (editor::ToggleGitBlameInline) still turns it on per
        // buffer, and <leader>g d / the git panel cover the rest.
        "inline_blame": {
            "enabled": false,
        },
    },
    "terminal": {
        "starts_open": false,
    },
    "project_panel": {
        "folder_indicator": "icon",
        "git_status_indicator": true,
        "file_icons": true,
        "entry_spacing": "comfortable",
        "default_width": 300.0,
        "dock": "left",
    },
    // Zed's inline AI autocomplete (Zeta). Disabled: the account is not
    // entitled to it, so the client only produced 403 spam while typing.
    "show_edit_predictions": false,
    // Formatting mirrors nvim's conform.nvim setup (nvim/lua/configs/conform.lua).
    // conform formats the WHOLE buffer on save and falls back to the language
    // server when no formatter is registered for the filetype, so:
    //   "on" (not "modifications_if_available") == conform's whole-buffer format
    //   "language_server" as the global formatter == conform's lsp_format = "fallback"
    // The per-language overrides at the bottom name the same tool nvim used.
    "format_on_save": "on",
    "formatter": "language_server",
    // nvim never strips trailing whitespace and never appends a missing final
    // newline (vim.opt.fixeol = false) - only the formatter itself touches those.
    // Zed does both on save by default, rewriting lines no formatter asked for.
    "remove_trailing_whitespace_on_save": false,
    "ensure_final_newline_on_save": false,
    "vim": {
        "use_smartcase_find": true,
        "toggle_relative_line_numbers": false,
        // Replicates nvim `o.cb = ''` + the "+y / "+p leader remaps:
        // yanks reach the system clipboard, deletes do not clobber it.
        "use_system_clipboard": "on_yank",
    },
    // options.lua equivalents
    "tab_size": 4, // o.tabstop / o.shiftwidth = 4
    "hard_tabs": false, // o.expandtab
    "soft_wrap": "none", // vim.opt.wrap = false
    "wrap_guides": [120], // vim.opt.colorcolumn = "120"
    "inlay_hints": {
        "enabled": true, // vim.lsp.inlay_hint.enable()
    },
    "toolbar": {
        "breadcrumbs": true,
    },
    "relative_line_numbers": "wrapped",
    "vertical_scroll_margin": 8.0,
    "which_key": {
        "enabled": false,
    },
    "icon_theme": {
        "mode": "dark",
        "light": "Zed (Default)",
        "dark": "Zed (Default)",
    },
    "base_keymap": "Zed",
    // Extensions live outside this file, so they do not travel with it.
    // Listing them here makes a fresh machine install them on first launch.
    "auto_install_extensions": {
        "html": true,
        "angular": true,
        "typst": true,
        "catppuccin": true,
        "catppuccin-icons": true,
    },
    "telemetry": {
        "diagnostics": true,
        "metrics": false,
        "anthropic_retention": false,
    },
    "session": {
        "trust_all_worktrees": true,
    },
    "vim_mode": true,
    "ui_font_size": 16,
    "buffer_font_size": 15,
    "theme": {
        "mode": "dark",
        "light": "One Light",
        "dark": "Tokyo Night",
    },

    // Neovim detects an Angular template as filetype "htmlangular", NOT "html"
    // (content-based - it does not need the .component.html suffix; v0.12 gets
    // src/app/**/*.html here). That distinction is load-bearing: conform's
    // formatters_by_ft maps "html", so htmlangular buffers match nothing and
    // fall through to lsp_format = "fallback".
    //
    // Zed has no content detection and the Angular extension only claims
    // "component.html"/"ng.html", so a project that drops the .component infix
    // lands on plain HTML -> Prettier. This restores the split.
    "file_types": {
        "Angular": ["**/src/app/**/*.html"],
    },

    "lsp": {
        "vtsls": {
            "settings": {
                "typescript": { "tsdk": "node_modules/typescript/lib" },
            },
        },
        "tinymist": {
            "settings": {
                // Compile on save
                // This will compile a PDF for the `main.typ` file in the project root.
                "exportPdf": "onSave",
                "outputPath": "$root/$name",

                // Enable formatter
                "formatterMode": "typstyle",
            },
        },
    },

    // conform's formatters_by_ft, translated. Anything absent inherits the global
    // "language_server" formatter above, which is conform's LSP fallback.
    "languages": {
        // Not in formatters_by_ft, so nvim formatted these with ts_ls (tsserver),
        // which only re-indents - it never rewrites quotes, never reflows to a
        // print width, never touches line endings.
        //
        // "formatter" alone does not keep Zed off Prettier here: Prettier is
        // "allowed" for these languages by default and still wins on save, so it
        // has to be switched off explicitly. Left on, Zed's bundled Prettier 3.x
        // picks up the printWidth/singleQuote config in a project's package.json
        // and rewrites double quotes to single, collapses wrapped calls up to the
        // print width, and - because Prettier's endOfLine defaults to "lf" -
        // rewrites every line of a CRLF file. Under Perforce that last one turns
        // a one-line edit into a whole-file changelist.
        "TypeScript": {
            "formatter": "language_server",
            "prettier": { "allowed": false },
        },
        "TSX": {
            "formatter": "language_server",
            "prettier": { "allowed": false },
        },
        "JavaScript": {
            "formatter": "language_server",
            "prettier": { "allowed": false },
        },
        "JSON": {
            "formatter": "prettier",
        },
        "JSONC": {
            "formatter": "prettier",
        },
        // src/index.html and friends are plain "html" in nvim too, so conform's
        // html = { "prettier" } really did apply to them.
        "HTML": {
            "formatter": "prettier",
        },
        // Angular templates. nvim formatted these with the html language server
        // (lspconfig attaches vscode-html-language-server to both "html" and
        // "htmlangular"), never with Prettier - so neither does Zed.
        //
        // This is not cosmetic. Prettier's "angular" and "html" parsers disagree
        // on 25 of this project's 32 templates: the angular parser understands
        // @if/@for control-flow blocks and indents their children one level in,
        // the html parser treats "@if (...) {" as text and flattens them. Zed
        // sends parser "html" for anything it calls HTML, so leaving Prettier on
        // here re-indents most of the file on every save.
        "Angular": {
            "formatter": "language_server",
            "prettier": { "allowed": false },
            "language_servers": ["vscode-html-language-server", "..."],
        },
        // Mason's bin holds .cmd shims and is not on PATH, so stylua and
        // csharpier point straight at the executables. clang-format (LLVM) and
        // gofumpt (~/go/bin) are already on PATH.
        "Lua": {
            "formatter": {
                "external": {
                    "command": "C:/Users/aCrYoZ/AppData/Local/nvim-data/mason/packages/stylua/stylua.exe",
                    "arguments": ["--stdin-filepath", "{buffer_path}", "-"],
                },
            },
        },
        "C": {
            "formatter": {
                "external": {
                    "command": "clang-format",
                    "arguments": ["--assume-filename={buffer_path}"],
                },
            },
        },
        "C++": {
            "formatter": {
                "external": {
                    "command": "clang-format",
                    "arguments": ["--assume-filename={buffer_path}"],
                },
            },
        },
        // Requires the "csharp" extension for the language to exist at all.
        // CSharpier 1.x needs an absolute --stdin-path; {buffer_path} is one.
        "C#": {
            "formatter": {
                "external": {
                    "command": "C:/Users/aCrYoZ/AppData/Local/nvim-data/mason/packages/csharpier/csharpier.exe",
                    "arguments": [
                        "format",
                        "--write-stdout",
                        "--stdin-path",
                        "{buffer_path}",
                    ],
                },
            },
        },
        // null-ls ran gofumpt + goimports-reviser (nvim/lua/configs/null-ls.lua).
        // goimports-reviser cannot read stdin, so gopls' organizeImports code
        // action stands in for it; gofumpt reads stdin with no arguments.
        "Go": {
            "formatter": [
                { "code_action": "source.organizeImports" },
                {
                    "external": {
                        "command": "gofumpt",
                        "arguments": [],
                    },
                },
            ],
        },
        // conform lists flake8 for python and mdformat for markdown. flake8 is a
        // linter, not a formatter, and mdformat is not installed on this machine
        // - both just error on save in nvim, so nothing formats here either.
        "Python": {
            "format_on_save": "off",
        },
        "Markdown": {
            "format_on_save": "off",
        },
        "Typst": {
            // Disable soft wrap
            "soft_wrap": "none",
        },
    },
}
