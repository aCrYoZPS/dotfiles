// Zed user tasks — https://zed.dev/docs/tasks
//
// Run with `task: spawn` from the command palette, or the keymap.json
// bindings under <leader>t.
[
  // ─────────────────────────────────────────────────────────────
  // Typst preview lives in the PROJECT, not here.
  //
  // Zed has no LSP-command bridge, so there is no direct equivalent of
  // nvim's `:TypstPreview` (typst-preview.nvim calls the tinymist command
  // over LSP and shells out to a browser itself).
  //
  // The closest thing is tinymist's "background preview": the preview
  // server runs inside the language server process, so it renders from the
  // in-memory buffer and follows your typing without a save. A standalone
  // `tinymist preview` process cannot do that — no access to the buffer,
  // it only sees the file on disk — so it is not used here.
  //
  // That server binds one fixed port, which is why both the port and the
  // task that opens a browser on it live per project:
  //     <project>/.zed/settings.json   enables it, pins the port
  //     <project>/.zed/tasks.json      "Typst: Open Preview"  (<leader>t p)
  // Ports so far: 23635 mzi, 23636 trpo — keep them distinct, or the second
  // project's tinymist dies on AddrInUse and is left with no LSP at all.
  //
  // Nothing to clean up: the preview exits with the language server, which
  // exits when the project closes.
  //
  // NB: do not add a task that kills tinymist by image name. Once tinymist
  // is on PATH (winget / cargo), Zed runs the language servers from that
  // same binary, so /IM tinymist.exe would take them down too.

  // ───────────────────────────────────────────────────────────
  // Run the current project
  //
  // Zed has no single "run the project" action. `task::Spawn` opens a picker
  // over these, and `task::Rerun` repeats whichever one you picked last with
  // no prompt — bound to <leader>r s and <leader>r r in keymap.json. So the
  // first run of a session costs one pick and every run after it is a chord.
  //
  // cwd is the worktree root, not the focused file's directory, so these run
  // the project regardless of which buffer happens to be open. $ZED_FILE and
  // friends are quoted because Windows paths contain spaces.
  //
  // Language extensions contribute their own runnables to the same picker
  // (cargo test at the cursor, go test for the package), so these only need
  // to cover the whole-project entry point.
  {
    "label": "Run: cargo run",
    "command": "cargo",
    "args": ["run"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "use_new_terminal": false,
    "allow_concurrent_runs": false
  },
  {
    "label": "Run: go run .",
    "command": "go",
    "args": ["run", "."],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "use_new_terminal": false,
    "allow_concurrent_runs": false
  },
  {
    "label": "Run: dotnet run",
    "command": "dotnet",
    "args": ["run"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "use_new_terminal": false,
    "allow_concurrent_runs": false
  },
  {
    "label": "Run: npm start",
    "command": "npm",
    "args": ["start"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "use_new_terminal": false,
    "allow_concurrent_runs": false
  },
  {
    "label": "Run: python (current file)",
    "command": "python",
    "args": ["\"$ZED_FILE\""],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "use_new_terminal": false,
    "allow_concurrent_runs": false
  }
]
