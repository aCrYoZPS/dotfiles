# Normalize to LF in the repo; check out LF everywhere by default.
* text=auto eol=lf

# Shell scripts MUST stay LF. A CRLF checkout breaks the shebang on
# macOS/Linux with: bad interpreter: /usr/bin/env bash^M
*.sh text eol=lf

# PowerShell is fine either way; CRLF is the Windows convention.
*.ps1 text eol=crlf

# Lua and JSON configs: LF, read fine by nvim and Zed on all platforms.
*.lua  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.toml text eol=lf
